	$(FLAC_DIR)/src/lpc.c \
	$(FLAC_DIR)/src/cpu.c \
	$(FLAC_DIR)/src/md5.c \
	$(FLAC_DIR)/src/fixed.c \
	$(LZMA_DIR)/src/LzmaEnc.c \
	$(LZMA_DIR)/src/LzFind.c \
	$(LZMA_DIR)/src/LzmaDec.c \
	$(ZLIB_DIR)/adler32.c \
	$(ZLIB_DIR)/crc32.c \
	$(ZLIB_DIR)/inffast.c \
	$(ZLIB_DIR)/inflate.c \
